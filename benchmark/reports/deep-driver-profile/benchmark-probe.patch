+
+/// Read-only thread accounting; unavailable files are explicit, not zero cost.
+Map<String, dynamic> sampleProcessThreads() {
+  try {
+    final threads = <Map<String, dynamic>>[];
+    for (final entry in Directory('/proc/self/task').listSync()) {
+      final stat = File('${entry.path}/stat').readAsStringSync();
+      final close = stat.lastIndexOf(')');
+      final values = stat.substring(close + 2).split(' ');
+      final scheduler = File('${entry.path}/schedstat');
+      threads.add({
+        'tid': int.parse(entry.path.split('/').last),
+        'name': stat.substring(stat.indexOf('(') + 1, close),
+        'state': values[0],
+        'userTicks': int.parse(values[11]),
+        'systemTicks': int.parse(values[12]),
+        if (scheduler.existsSync())
+          'scheduler': scheduler.readAsStringSync().trim(),
+      });
+    }
+    return {'available': true, 'threads': threads};
+  } on Object catch (error) {
+    return {'available': false, 'reason': error.toString()};
+  }
+}
+
+Map<String, dynamic> nativeProfileCapabilities() {
+  String? read(String path) {
+    try {
+      return File(path).readAsStringSync().trim();
+    } on Object {
+      return null;
+    }
+  }
+
+  return {
+    'probeVersion': 'driver-wall-and-thread-cpu-v1',
+    'kernel': read('/proc/version'),
+    'perfEventParanoid': read('/proc/sys/kernel/perf_event_paranoid'),
+    'schedulerStats': read('/proc/self/schedstat'),
+    'threads': sampleProcessThreads(),
+  };
+}
