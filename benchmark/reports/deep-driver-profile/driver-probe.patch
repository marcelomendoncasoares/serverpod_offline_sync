@@ -0,0 +1,132 @@
+// Temporary benchmark instrumentation. This file is not a driver API change.
+import 'dart:async';
+import 'dart:ffi';
+import 'dart:io';
+
+const benchmarkWireObserverKey = #offlineSyncBenchmarkWireObserver;
+const benchmarkWireProbeKey = #offlineSyncBenchmarkWireProbe;
+
+typedef WireObserver = void Function(Map<String, Object?> record);
+
+final class _Timespec extends Struct {
+  @Int64()
+  external int seconds;
+
+  @Int64()
+  external int nanoseconds;
+}
+
+class _ThreadCpuClock {
+  _ThreadCpuClock() {
+    if (!Platform.isLinux) return;
+    try {
+      final library = DynamicLibrary.process();
+      final malloc = library
+          .lookupFunction<
+            Pointer<Void> Function(IntPtr),
+            Pointer<Void> Function(int)
+          >('malloc');
+      _clock = library
+          .lookupFunction<
+            Int32 Function(Int32, Pointer<_Timespec>),
+            int Function(int, Pointer<_Timespec>)
+          >('clock_gettime');
+      _value = malloc(sizeOf<_Timespec>()).cast<_Timespec>();
+    } on Object {
+      _clock = null;
+    }
+  }
+
+  int Function(int, Pointer<_Timespec>)? _clock;
+  Pointer<_Timespec>? _value;
+
+  int? read() {
+    final value = _value;
+    if (value == null || value == nullptr || _clock?.call(3, value) != 0) {
+      return null;
+    }
+    return value.ref.seconds * 1000000 + value.ref.nanoseconds ~/ 1000;
+  }
+}
+
+class BenchmarkWireProbe {
+  BenchmarkWireProbe(this.output, this.command) {
+    prepareCpuStart = _cpu.read();
+  }
+
+  static final _cpu = _ThreadCpuClock();
+  static BenchmarkWireProbe? get current =>
+      Zone.current[benchmarkWireProbeKey] as BenchmarkWireProbe?;
+
+  final WireObserver output;
+  final String command;
+  final watch = Stopwatch()..start();
+  final marks = <String, int>{'executeStart': 0};
+  final cpuMicros = <String, int>{};
+  final messageCounts = <String, int>{};
+  final messageTimeline = <Map<String, Object?>>[];
+  int droppedMessages = 0;
+  int? prepareCpuStart;
+  int? sendCpuStart;
+  bool asynchronousCodec = false;
+
+  void mark(String name) {
+    marks.putIfAbsent(name, () => watch.elapsedMicroseconds);
+  }
+
+  int? cpuStart() => _cpu.read();
+
+  void cpuEnd(String name, int? start) {
+    final end = _cpu.read();
+    if (start != null && end != null && end >= start) {
+      cpuMicros.update(
+        name,
+        (value) => value + end - start,
+        ifAbsent: () => end - start,
+      );
+    }
+  }
+
+  void scheduled() {
+    mark('scheduled');
+    cpuEnd('prepare', prepareCpuStart);
+  }
+
+  void operationReady() {
+    mark('operationReady');
+    sendCpuStart = cpuStart();
+  }
+
+  void sent() {
+    mark('sent');
+    if (!asynchronousCodec) cpuEnd('encodeAndSend', sendCpuStart);
+  }
+
+  void message(String name) {
+    mark('firstMessage');
+    if (messageTimeline.length < 32) {
+      messageTimeline.add({'name': name, 'micros': watch.elapsedMicroseconds});
+    } else {
+      droppedMessages++;
+    }
+    messageCounts.update(name, (value) => value + 1, ifAbsent: () => 1);
+    if (name == 'ReadyForQueryMessage') mark('ready');
+  }
+
+  void finish() {
+    mark('executeEnd');
+    try {
+      output({
+        'command': command,
+        'marksMicros': marks,
+        'threadCpuMicros': cpuMicros,
+        'messages': messageCounts,
+        'messageTimeline': messageTimeline,
+        'droppedMessages': droppedMessages,
+        'asynchronousCodec': asynchronousCodec,
+      });
+    } on Object {
+      // A diagnostic observer must not affect a query's result or cleanup.
+    }
+  }
+}
